# Enable URL rewriting for extensionless PHP routes
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Preserve existing files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Redirect legacy/alternate slugs to canonical extensionless URLs
    RewriteRule ^toddler-programme/?$ toddler [R=301,L,NC]
    RewriteRule ^daycare/?$ day-care [R=301,L,NC]
    RewriteRule ^about/?$ about-us [R=301,L,NC]
    RewriteRule ^team/?$ our-team [R=301,L,NC]
    RewriteRule ^contact/?$ contact-us [R=301,L,NC]

    # Redirect external .php GET/HEAD requests to extensionless URLs (no loop)
    RewriteCond %{THE_REQUEST} \s/+([^\s?]*?/)?index\.php[\s?] [NC]
    RewriteRule ^ %1 [R=301,L]

    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} \s/+([^\s?]*)\.php[\s?] [NC]
    RewriteRule ^(.*)\.php$ $1 [R=301,L]

    # Internally rewrite extensionless URLs to corresponding .php files
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>

# Disable MultiViews so mod_rewrite handles extensionless routing cleanly
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

