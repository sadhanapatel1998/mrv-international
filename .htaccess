
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /dashboard/mrv-international/

    # Preserve existing files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Redirect alternate slugs to canonical URLs
    RewriteRule ^toddler-programme/?$ toddler [R=302,L,NC]
    RewriteRule ^daycare/?$ day-care [R=302,L,NC]
    RewriteRule ^about/?$ about-us [R=302,L,NC]
    RewriteRule ^team/?$ our-team [R=302,L,NC]
    RewriteRule ^contact/?$ contact-us [R=302,L,NC]

    # Redirect index.php to homepage
    RewriteCond %{THE_REQUEST} \s/+dashboard/mrv-international/index\.php[\s?] [NC]
    RewriteRule ^index\.php$ ./ [R=302,L]

    # Redirect direct PHP URLs to extensionless URLs
    RewriteCond %{THE_REQUEST} \s/+dashboard/mrv-international/(.+?)\.php[\s?] [NC]
    RewriteRule ^(.+)\.php$ $1 [R=302,L,NC]

    # Internally rewrite extensionless URLs to PHP files
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>
